{
  "schemaVersion": "scanner-manifest/v1",
  "id": "archie.dotnet",
  "version": "1.1.0",
  "executable": "dotnet",
  "arguments": ["Archie.Scanner.DotNet.dll"],
  "artifactGlobs": ["**/*.sln", "**/*.slnx", "**/*.csproj"],
  "capabilities": ["dotnet-structure", "aspnet-http", "kafka-messaging", "azure-service-bus", "azure-functions-bindings"],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "permissions": {
    "readRepository": true,
    "network": false,
    "environment": false
  }
}
